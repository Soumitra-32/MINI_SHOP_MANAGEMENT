-- Database schema for Mini Shop / Expense Management System (PostgreSQL)

-- Admin table
CREATE TABLE IF NOT EXISTS admin (
    id SERIAL PRIMARY KEY,
    name VARCHAR(50) NOT NULL UNIQUE,
    password VARCHAR(255) NOT NULL,
    admin_key VARCHAR(100) NOT NULL
);

-- Employee table
CREATE TABLE IF NOT EXISTS employee (
    id SERIAL PRIMARY KEY,
    username VARCHAR(50) NOT NULL UNIQUE,
    password VARCHAR(255) NOT NULL
);

-- Categories table
CREATE TABLE IF NOT EXISTS categories (
    id SERIAL PRIMARY KEY,
    name VARCHAR(100) NOT NULL UNIQUE,
    quantity INT DEFAULT 0
);

-- Companies table (products supplied by company for a category)
CREATE TABLE IF NOT EXISTS companies (
    id SERIAL PRIMARY KEY,
    company_name VARCHAR(100) NOT NULL,
    category_name VARCHAR(100) NOT NULL,
    quantity INT DEFAULT 0,
    price NUMERIC(10, 2) DEFAULT 0.00,
    selling_price NUMERIC(10, 2) DEFAULT 0.00,
    UNIQUE (category_name, company_name)
);

-- Transactions table
CREATE TABLE IF NOT EXISTS transactions (
    id SERIAL PRIMARY KEY,
    type VARCHAR(20) NOT NULL DEFAULT 'Income', -- 'Income' or 'Expense'
    category VARCHAR(100) NOT NULL,
    company_name VARCHAR(100),
    quantity INT DEFAULT 1,
    amount NUMERIC(10, 2) NOT NULL,
    currency VARCHAR(20) DEFAULT 'BDT',
    date DATE NOT NULL,
    notes TEXT,
    name VARCHAR(100) NOT NULL,
    status VARCHAR(50)
);

-- Settings table for key-value configurations (currency, monthly budget, etc.)
CREATE TABLE IF NOT EXISTS settings (
    setting_key VARCHAR(100) PRIMARY KEY,
    value VARCHAR(255) NOT NULL
);

-- Expenses table (for specific monthly expense records)
CREATE TABLE IF NOT EXISTS expenses (
    id SERIAL PRIMARY KEY,
    expense_name VARCHAR(100) NOT NULL,
    amount NUMERIC(10, 2) NOT NULL,
    month INT NOT NULL,
    year INT NOT NULL
);

